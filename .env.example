# Supabase (proyecto: gprosoft-chatbot)
SUPABASE_URL=https://kczbfnatswgbkupipydt.supabase.co
# Sacala de: Supabase Dashboard -> tu proyecto -> Settings -> API -> service_role key
# OJO: esta clave es secreta, nunca la subas a un repo publico ni la pongas en el frontend
